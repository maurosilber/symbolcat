# The operators sharing a signature are assigned the same overloads.
# ruff: noqa: PYI017

# Static signatures of the operator overloads (see overloads.py).
#
# Each operator gives the kind of its result from the kinds of its operands,
# as the rules in ``kind_algebra`` do at runtime. The shapes of arrays and the
# kinds of their entries are only checked at runtime.
#
# The overloads are tried in order: the scalar ones first, so a signature
# accepting a scalar or an array only matches when an array is involved.

from numbers import Complex as _ComplexNumber
from numbers import Real as _RealNumber
from typing import Any, overload

from .expr import Call, Expr
from ..types._kinds import Boolean, Complex, Kind, Matrix, Real, Vector

type RealNumber = float | _RealNumber
type ComplexNumber = complex | _ComplexNumber
type R = Overloads[Real] | RealNumber
type C = Overloads[Complex] | ComplexNumber
type V = Overloads[Vector]
type M = Overloads[Matrix]

class Overloads[K: Kind]:
    @property
    def kind(self) -> K: ...  # makes K covariant: an Expr[Real] is an Expr[Complex]
    # arithmetic: real or complex, broadcasting scalars over arrays
    @overload
    def _arith(self: Overloads[Real], other: R, /) -> Call[Expr, Real]: ...
    @overload
    def _arith(self: Overloads[Complex], other: C, /) -> Call[Expr, Complex]: ...
    @overload
    def _arith(self: Overloads[Complex], other: V, /) -> Call[Expr, Vector]: ...
    @overload
    def _arith(self: Overloads[Complex], other: M, /) -> Call[Expr, Matrix]: ...
    @overload
    def _arith(self: V, other: V | C, /) -> Call[Expr, Vector]: ...
    @overload
    def _arith(self: M, other: M | C, /) -> Call[Expr, Matrix]: ...
    @overload
    def _rarith(self: Overloads[Real], other: RealNumber, /) -> Call[Expr, Real]: ...
    @overload
    def _rarith(
        self: Overloads[Complex], other: ComplexNumber, /
    ) -> Call[Expr, Complex]: ...
    @overload
    def _rarith(self: V, other: ComplexNumber, /) -> Call[Expr, Vector]: ...
    @overload
    def _rarith(self: M, other: ComplexNumber, /) -> Call[Expr, Matrix]: ...

    __add__ = __sub__ = __mul__ = __truediv__ = __pow__ = _arith
    __radd__ = __rsub__ = __rmul__ = __rtruediv__ = __rpow__ = _rarith

    # only defined for reals
    @overload
    def _real(self: Overloads[Real], other: R, /) -> Call[Expr, Real]: ...
    @overload
    def _real(self: Overloads[Real], other: V, /) -> Call[Expr, Vector]: ...
    @overload
    def _real(self: Overloads[Real], other: M, /) -> Call[Expr, Matrix]: ...
    @overload
    def _real(self: V, other: V | R, /) -> Call[Expr, Vector]: ...
    @overload
    def _real(self: M, other: M | R, /) -> Call[Expr, Matrix]: ...
    @overload
    def _rreal(self: Overloads[Real], other: RealNumber, /) -> Call[Expr, Real]: ...
    @overload
    def _rreal(self: V, other: RealNumber, /) -> Call[Expr, Vector]: ...
    @overload
    def _rreal(self: M, other: RealNumber, /) -> Call[Expr, Matrix]: ...

    __floordiv__ = __mod__ = __lshift__ = __rshift__ = _real
    __rfloordiv__ = __rmod__ = __rlshift__ = __rrshift__ = _rreal

    # logical on booleans, bitwise on reals
    @overload
    def _logical(
        self: Overloads[Boolean], other: Overloads[Boolean] | bool, /
    ) -> Call[Expr, Boolean]: ...
    @overload
    def _logical(self: Overloads[Real], other: R, /) -> Call[Expr, Real]: ...
    @overload
    def _logical(self: Overloads[Real], other: V, /) -> Call[Expr, Vector]: ...
    @overload
    def _logical(self: Overloads[Real], other: M, /) -> Call[Expr, Matrix]: ...
    @overload
    def _logical(self: V, other: V | R, /) -> Call[Expr, Vector]: ...
    @overload
    def _logical(self: M, other: M | R, /) -> Call[Expr, Matrix]: ...
    @overload
    def _rlogical(self: Overloads[Boolean], other: bool, /) -> Call[Expr, Boolean]: ...
    @overload
    def _rlogical(self: Overloads[Real], other: RealNumber, /) -> Call[Expr, Real]: ...
    @overload
    def _rlogical(self: V, other: RealNumber, /) -> Call[Expr, Vector]: ...
    @overload
    def _rlogical(self: M, other: RealNumber, /) -> Call[Expr, Matrix]: ...

    __and__ = __or__ = __xor__ = _logical
    __rand__ = __ror__ = __rxor__ = _rlogical

    # comparisons: booleans, entry by entry for arrays
    @overload
    def _compare(self: Overloads[Real], other: R, /) -> Call[Expr, Boolean]: ...
    @overload
    def _compare(self: Overloads[Real], other: V, /) -> Call[Expr, Vector]: ...
    @overload
    def _compare(self: Overloads[Real], other: M, /) -> Call[Expr, Matrix]: ...
    @overload
    def _compare(self: V, other: V | R, /) -> Call[Expr, Vector]: ...
    @overload
    def _compare(self: M, other: M | R, /) -> Call[Expr, Matrix]: ...

    __lt__ = __le__ = __gt__ = __ge__ = _compare

    # matrix product, as NumPy
    @overload
    def __matmul__(self: V, other: V, /) -> Call[Expr, Real]: ...
    @overload
    def __matmul__(self: M, other: V, /) -> Call[Expr, Vector]: ...
    @overload
    def __matmul__(self: V, other: M, /) -> Call[Expr, Vector]: ...
    @overload
    def __matmul__(self: M, other: M, /) -> Call[Expr, Matrix]: ...

    # an entry of a vector, a row of a matrix, or an item of a scalar that is
    # a container (of unknown kind)
    @overload
    def __getitem__(self: V, key: R, /) -> Call[Expr, Real]: ...
    @overload
    def __getitem__(self: M, key: R, /) -> Call[Expr, Vector]: ...
    @overload
    def __getitem__(self: Overloads[Complex], key: Any, /) -> Call[Expr, Any]: ...

    # unary
    @overload
    def __neg__(self: Overloads[Real]) -> Call[Expr, Real]: ...
    @overload
    def __neg__(self: Overloads[Complex]) -> Call[Expr, Complex]: ...
    @overload
    def __neg__(self: V) -> Call[Expr, Vector]: ...
    @overload
    def __neg__(self: M) -> Call[Expr, Matrix]: ...
    __pos__ = __neg__
    @overload
    def __invert__(self: Overloads[Boolean]) -> Call[Expr, Boolean]: ...
    @overload
    def __invert__(self: Overloads[Real]) -> Call[Expr, Real]: ...
    @overload
    def __invert__(self: V) -> Call[Expr, Vector]: ...
    @overload
    def __invert__(self: M) -> Call[Expr, Matrix]: ...
